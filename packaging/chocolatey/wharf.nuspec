<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package for wharf.

  Not generated by GoReleaser: `choco pack` needs the choco binary, which only
  exists on a Windows runner, while the rest of the release pipeline runs on
  Linux. The chocolatey job in .github/workflows/release.yml stamps the version
  in, drops wharf.exe into tools/ and packs this.

  The binary is embedded rather than downloaded at install time, so an install
  needs no network beyond the Chocolatey feed itself, and the package is exactly
  what moderation reviewed. Chocolatey shims any .exe under tools/ automatically,
  which is why there is no install script.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>wharf</id>
    <version>0.0.0</version>
    <packageSourceUrl>https://github.com/Janne6565/wharf-tui/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>Janne6565</owners>

    <title>wharf</title>
    <authors>Janne Keipert</authors>
    <projectUrl>https://wharf.jannekeipert.de</projectUrl>
    <projectSourceUrl>https://github.com/Janne6565/wharf-tui</projectSourceUrl>
    <docsUrl>https://github.com/Janne6565/wharf-tui/blob/main/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/Janne6565/wharf-tui/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/Janne6565/wharf-tui/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>ssh terminal tui cli devops ssh-client</tags>
    <summary>Keyboard-driven terminal SSH client with a local-first encrypted vault</summary>
    <description><![CDATA[
Wharf manages your SSH hosts, keys and sessions from a fast, keyboard-driven TUI.

It is **local-first**: hosts, keys and sessions all work with no account, backed by a
local encrypted vault (argon2id + XChaCha20-Poly1305). Signing in only adds the online
features — cross-machine sync and shared team projects — under a zero-knowledge model
where the server never sees anything but ciphertext.

* Hosts searchable and filterable by tag, project and reachability
* ED25519/RSA keys and identities, with ssh-agent support
* Tabbed sessions, port forwarding (-L/-R/-D) and `~/.ssh/config` import
* Three themes, and `?` for the keymap

**On Windows**, sessions run inside wharf itself: detaching with `ctrl+\` keeps a session
running while wharf is open, but quitting closes it. On macOS and Linux sessions outlive
wharf and are picked up again by the next run.
    ]]></description>
    <releaseNotes>https://github.com/Janne6565/wharf-tui/releases</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
